{
  "name": "material-asus-router",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted web app that manages an Asus router over SSH with readable controls, previews and undo.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "test": "node --test tests/",
    "site": "node scripts/build-site.mjs site"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/material-symbols-rounded": "5.3.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ssh2": "1.17.0"
  }
}
